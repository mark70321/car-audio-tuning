<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">量測引擎驗證</string>

    <!-- 說明 -->
    <string name="section_howto">怎麼測</string>
    <string name="howto_steps">1. 手機用藍牙連上車機，車機切到藍牙音樂\n2. 熄火或怠速、關窗、關冷氣\n3. 手機放駕駛座頭枕旁、耳朵高度，麥克風（手機底部）朝前，測量時不要動它\n4. 車機音量調到平常聽音樂偏大聲的程度\n5. 按「開始連測 3 次」，會聽到 3 次「嗚——」由低到高的聲音，每次約 9 秒，期間保持安靜</string>
    <string name="howto_volume_warning">⚠️ 第一次先用小音量試一次，聲音太大會傷耳朵。</string>

    <!-- 量測 -->
    <string name="section_measure">量測</string>
    <string name="choose_source">收音來源：</string>
    <string name="source_unprocessed">UNPROCESSED（原始）</string>
    <string name="source_voice_recognition">VOICE_RECOGNITION（語音辨識）</string>
    <string name="source_mic">MIC（一般）</string>
    <string name="source_unsupported">這支手機不支援 UNPROCESSED，按了會失敗</string>
    <string name="btn_start">開始連測 %1$d 次</string>
    <string name="running">第 %1$d / %2$d 次量測中，請保持安靜…</string>
    <string name="permission_denied">沒有麥克風權限，無法量測。請到系統設定允許麥克風。</string>
    <string name="measure_error">量測失敗：%1$s</string>
    <string name="saved_to">已存檔（手機接電腦後 Claude 可直接讀取）：%1$s</string>
    <string name="sample_rate">取樣率：%1$d Hz</string>

    <!-- 結果 -->
    <string name="section_result">結果：%1$s</string>
    <string name="no_result">這個收音來源還沒量過</string>
    <string name="run_line">第 %1$d 次：延遲 %2$.0f ms、峰值 %3$.1f dBFS、訊噪比 %4$.0f dB</string>
    <string name="warn_clipped">　⚠️ 太大聲（爆音），把音量調小再測</string>
    <string name="warn_quiet">　⚠️ 太小聲，把音量調大再測</string>
    <string name="warn_noisy">　⚠️ 背景太吵，結果可能不準</string>
    <string name="spread_line">三次差異（100Hz～10kHz）最大 %1$.1f dB；40Hz～16kHz 最大 %2$.1f dB</string>
    <string name="verdict_good">很穩定 ✅</string>
    <string name="verdict_ok">可接受</string>
    <string name="verdict_poor">不穩定 ❌（檢查手機有沒有移動、周圍有沒有噪音）</string>
    <string name="chart_hint">橫軸是頻率（左低音、右高音），縱軸是音量。三條線越重疊代表量測越穩定。</string>

    <!-- 比較 -->
    <string name="section_compare">收音來源比較</string>
    <string name="compare_line">%1$s：差異 %2$.1f dB（%3$s），平均訊噪比 %4$.0f dB</string>
    <string name="compare_empty">每種來源都量過一輪後，這裡會列出比較</string>

    <string name="btn_share">分享量測結果（傳給自己或 Claude）</string>
    <string name="share_title">分享量測結果</string>
    <string name="btn_clear">清除全部結果</string>
</resources>
